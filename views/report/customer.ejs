<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <a href="/report" class="text-muted text-decoration-none fs-85"><i class="bi bi-arrow-left"></i> กลับไปยังศูนย์รายงาน</a>
    <h5 class="mb-0 fw-700 mt-1">รายงานลูกค้า</h5>
    <p class="text-muted mb-0 fs-85">จำนวนลูกค้า ลูกค้าใหม่รายเดือน และการกระจายตัวตามอายุ</p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-light border"><i class="bi bi-printer me-1"></i>พิมพ์</button>
    <button class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
    <button class="btn btn-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
  </div>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="text-muted fs-85">ลูกค้าทั้งหมด</div>
        <div class="h3 fw-700 mb-1 mt-1"><%= fmtInt(kpi.totalCustomers) %></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="text-muted fs-85">ลูกค้าใหม่เดือนนี้</div>
        <div class="h3 fw-700 mb-1 mt-1 text-success">+<%= kpi.newThisMonth %></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="text-muted fs-85">มีสัญญาหลายฉบับ</div>
        <div class="h3 fw-700 mb-1 mt-1"><%= fmtInt(kpi.multiContract) %></div>
        <div class="fs-78 text-muted"><%= ((kpi.multiContract/kpi.totalCustomers)*100).toFixed(1) %>% ของลูกค้าทั้งหมด</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="text-muted fs-85">สัญญาเฉลี่ย/คน</div>
        <div class="h3 fw-700 mb-1 mt-1"><%= kpi.avgLoanPerCustomer %></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- New customers trend -->
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-body p-4">
        <h6 class="mb-3 fw-600">ลูกค้าใหม่รายเดือน</h6>
        <% const maxNew = Math.max(...monthly.map(m => m.newCustomers)); %>
        <div class="bar-chart">
          <% monthly.forEach(m => { %>
            <div class="bar-item">
              <div class="bar-value"><%= m.newCustomers %></div>
              <div class="bar-stack">
                <div class="bar bg-info" style="height:<%= (m.newCustomers/maxNew*100).toFixed(0) %>%"></div>
              </div>
              <div class="bar-label"><%= m.month %></div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Age distribution -->
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-body p-4">
        <h6 class="mb-3 fw-600">ช่วงอายุลูกค้า</h6>
        <% const totalAge = ageGroups.reduce((s,x)=>s+x.count,0); %>
        <div class="d-flex flex-column gap-3">
          <% ageGroups.forEach(g => { %>
            <div>
              <div class="d-flex justify-content-between mb-1">
                <span class="fs-88">
                  <span class="d-inline-block rounded-circle me-2" style="width:10px;height:10px;background:<%= g.color %>"></span>
                  <%= g.group %>
                </span>
                <span class="fw-600 fs-85"><%= fmtInt(g.count) %> <span class="text-muted fs-78">(<%= ((g.count/totalAge)*100).toFixed(1) %>%)</span></span>
              </div>
              <div class="progress">
                <div class="progress-bar" style="width:<%= (g.count/totalAge*100).toFixed(1) %>%; background:<%= g.color %>"></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
