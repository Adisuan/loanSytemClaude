<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — ระบบสินเชื่อ</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<!-- Sidebar -->
<nav class="sidebar d-flex flex-column">
  <div class="sidebar-brand d-flex align-items-center gap-3">
    <div class="logo-icon"><i class="bi bi-bank2"></i></div>
    <div>
      <div class="text-white fw-700 fs-95">LoanPro</div>
      <div class="text-white-50 fs-75">ระบบสินเชื่อ</div>
    </div>
  </div>

  <div class="pt-2 flex-grow-1 overflow-auto">
    <div class="nav-section">เมนูหลัก</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link <%= page==='dashboard' ? 'active' : '' %>" href="/">
          <i class="bi bi-grid-1x2-fill me-2"></i> แดชบอร์ด
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='loans' ? 'active' : '' %>" href="/loan">
          <i class="bi bi-file-earmark-text-fill me-2"></i> รายการสินเชื่อ
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='apply' ? 'active' : '' %>" href="/loan/apply">
          <i class="bi bi-plus-circle-fill me-2"></i> ยื่นขอสินเชื่อ
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='payment' ? 'active' : '' %>" href="/payment">
          <i class="bi bi-cash-coin me-2"></i> การชำระเงิน
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='collaterals' ? 'active' : '' %>" href="/collateral">
          <i class="bi bi-shield-fill me-2"></i> หลักประกัน
        </a>
      </li>
    </ul>

    <div class="nav-section">ลูกค้า</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link <%= page==='customers' ? 'active' : '' %>" href="/customer">
          <i class="bi bi-people-fill me-2"></i> ข้อมูลลูกค้า
        </a>
      </li>
    </ul>

    <div class="nav-section">รายงาน</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link <%= page==='reports' ? 'active' : '' %>" href="/reports">
          <i class="bi bi-graph-up-arrow me-2"></i> ศูนย์รายงาน
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='reports-summary' ? 'active' : '' %>" href="/reports/summary">
          <i class="bi bi-bar-chart-line me-2"></i> สรุปสินเชื่อ
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='reports-revenue' ? 'active' : '' %>" href="/reports/revenue">
          <i class="bi bi-cash-stack me-2"></i> รายรับ
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= page==='reports-overdue' ? 'active' : '' %>" href="/reports/overdue">
          <i class="bi bi-exclamation-triangle me-2"></i> หนี้ค้างชำระ
        </a>
      </li>
    </ul>

    <div class="nav-section">ระบบ</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link <%= page==='settings' ? 'active' : '' %>" href="/settings">
          <i class="bi bi-gear-fill me-2"></i> ตั้งค่า
        </a>
      </li>
    </ul>
  </div>

  <div class="p-3 border-top border-sidebar">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white avatar-md">อด</div>
      <div>
        <div class="text-white fs-82 fw-600">อดิสรรณ์</div>
        <div class="text-white-50 fs-72">ผู้ดูแลระบบ</div>
      </div>
      <a href="#" class="ms-auto text-white-50"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </div>
</nav>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Main -->
<div class="main-content">
  <!-- Topbar -->
  <div class="topbar d-flex align-items-center gap-3">
    <button class="btn btn-sm btn-light d-lg-none border-0" id="sidebarToggle">
      <i class="bi bi-list fs-5"></i>
    </button>
    <nav aria-label="breadcrumb" class="flex-grow-1">
      <ol class="breadcrumb mb-0 fs-85">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">หน้าหลัก</a></li>
        <% if (typeof breadcrumb !== 'undefined') { %>
          <li class="breadcrumb-item active"><%= breadcrumb %></li>
        <% } %>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-sm btn-light border-0 position-relative">
        <i class="bi bi-bell"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger fs-60">3</span>
      </button>
      <div class="text-muted d-none d-sm-block fs-82">2 พ.ค. 2569</div>
    </div>
  </div>

  <div class="p-3 p-lg-4">
