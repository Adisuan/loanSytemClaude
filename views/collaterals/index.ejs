<%- include('../partials/header', { title: 'หลักประกัน', page: 'collaterals', breadcrumb: 'หลักประกัน' }) %>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-0 fw-700">หลักประกัน</h5>
    <p class="text-muted mb-0 fs-85">จัดการหลักประกันทั้งหมด ก่อนผูกเข้ากับสัญญาสินเชื่อ</p>
  </div>
  <a href="/collaterals/new" class="btn btn-primary">
    <i class="bi bi-plus-circle me-2"></i>เพิ่มหลักประกัน
  </a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-shield-fill"></i>
          </div>
          <span class="badge bg-primary bg-opacity-15 text-primary fs-72">ทั้งหมด</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.total %></div>
        <div class="text-muted fs-83">หลักประกันทั้งหมด</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-success bg-opacity-10 text-success">
            <i class="bi bi-check2-circle"></i>
          </div>
          <span class="badge bg-success bg-opacity-15 text-success fs-72">พร้อมใช้</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.available %></div>
        <div class="text-muted fs-83">ว่าง</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-link-45deg"></i>
          </div>
          <span class="badge bg-warning bg-opacity-20 text-warning fs-72">ติดสัญญา</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.inUse %></div>
        <div class="text-muted fs-83">ใช้ค้ำอยู่</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-info bg-opacity-10 text-info">
            <i class="bi bi-cash-stack"></i>
          </div>
          <span class="badge bg-info bg-opacity-15 text-info fs-72">มูลค่ารวม</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2">฿<%= stats.sumValue %></div>
        <div class="text-muted fs-83">มูลค่าประเมินรวม</div>
      </div>
    </div>
  </div>
</div>

<!-- Search & Filter -->
<div class="card mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control border-start-0 ps-0" placeholder="ค้นหารหัส, ชื่อ, รายละเอียด...">
        </div>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกประเภท</option>
          <option>โฉนดที่ดิน</option>
          <option>รถยนต์</option>
          <option>รถจักรยานยนต์</option>
          <option>โทรศัพท์</option>
          <option>เครื่องใช้ไฟฟ้า</option>
          <option>ทอง</option>
          <option>อื่น ๆ</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกสถานะ</option>
          <option>ว่าง</option>
          <option>ใช้ค้ำอยู่</option>
          <option>ปลดแล้ว</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>ค้นหา</button>
        <button class="btn btn-light border"><i class="bi bi-download"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width:40px;">
              <input type="checkbox" class="form-check-input">
            </th>
            <th>รหัส</th>
            <th>ประเภท / รายละเอียด</th>
            <th>มูลค่าประเมิน</th>
            <th>สถานะ</th>
            <th>สัญญาที่ผูก</th>
            <th>วันที่เพิ่ม</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% collaterals.forEach(c => { %>
          <tr>
            <td class="ps-4"><input type="checkbox" class="form-check-input"></td>
            <td>
              <a href="/collaterals/<%= c.id %>" class="text-primary fw-500 text-decoration-none">
                <%= c.id %>
              </a>
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="rounded d-flex align-items-center justify-content-center text-white avatar-md flex-shrink-0"
                     style="background:<%= c.color %>; width:36px; height:36px;">
                  <i class="bi <%= c.icon %>"></i>
                </div>
                <div>
                  <div class="fs-88 fw-500"><%= c.title %></div>
                  <div class="text-muted fs-78"><%= c.type %> · <%= c.description %></div>
                </div>
              </div>
            </td>
            <td class="fw-500">฿<%= c.estimatedValue %></td>
            <td>
              <% if (c.status === 'ว่าง') { %>
                <span class="badge-status bg-success bg-opacity-15 text-success">
                  <i class="bi bi-check-circle-fill me-1"></i>ว่าง
                </span>
              <% } else if (c.status === 'ใช้ค้ำอยู่') { %>
                <span class="badge-status bg-warning bg-opacity-20 text-warning">
                  <i class="bi bi-link-45deg me-1"></i>ใช้ค้ำอยู่
                </span>
              <% } else { %>
                <span class="badge-status bg-secondary bg-opacity-15 text-secondary">
                  <i class="bi bi-archive-fill me-1"></i>ปลดแล้ว
                </span>
              <% } %>
            </td>
            <td>
              <% if (c.loanId) { %>
                <a href="/loans/<%= c.loanId %>" class="text-primary text-decoration-none fs-85">
                  <%= c.loanId %>
                </a>
                <div class="text-muted fs-75">ผูกเมื่อ <%= c.attachedDate %></div>
              <% } else { %>
                <span class="text-muted fs-85">-</span>
              <% } %>
            </td>
            <td class="text-muted fs-85"><%= c.addedDate %></td>
            <td>
              <div class="dropdown">
                <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown">
                  <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 dropdown-menu-text">
                  <li><a class="dropdown-item" href="/collaterals/<%= c.id %>"><i class="bi bi-eye me-2"></i>ดูรายละเอียด</a></li>
                  <li><a class="dropdown-item" href="/collaterals/<%= c.id %>/edit"><i class="bi bi-pencil me-2"></i>แก้ไข</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <form action="/collaterals/<%= c.id %>/delete" method="POST" class="m-0">
                      <button type="submit" class="dropdown-item text-danger"
                              <%= c.status === 'ใช้ค้ำอยู่' ? 'disabled' : '' %>>
                        <i class="bi bi-trash me-2"></i>ลบ
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="d-flex align-items-center justify-content-between p-3 border-top flex-wrap gap-2">
      <div class="text-muted fs-85">แสดง 1-<%= collaterals.length %> จาก <%= collaterals.length %> รายการ</div>
      <nav>
        <ul class="pagination pagination-sm mb-0 gap-1">
          <li class="page-item disabled"><a class="page-link border-0" href="#">&laquo;</a></li>
          <li class="page-item active"><a class="page-link rounded" href="#">1</a></li>
          <li class="page-item"><a class="page-link border-0" href="#">&raquo;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
