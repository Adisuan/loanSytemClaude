<%
  const fmtCompact = (n) => {
    if (n >= 1e6) return '฿' + (n / 1e6).toFixed(2) + 'M';
    if (n >= 1e3) return '฿' + (n / 1e3).toFixed(1) + 'K';
    return '฿' + Math.round(n).toLocaleString('th-TH');
  };
%>

<div class="apply-page-hero mb-4">
  <div>
    <h5 class="hero-title">รายการสินเชื่อ</h5>
    <p class="hero-sub">จัดการและติดตามสินเชื่อทั้งหมดในระบบ</p>
  </div>
  <a href="/loan/apply" class="btn btn-primary">
    <i class="bi bi-plus-circle me-2"></i>ยื่นขอสินเชื่อใหม่
  </a>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="icon-box bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-wallet2"></i>
          </div>
          <span class="badge bg-primary bg-opacity-15 text-primary">รวมทั้งระบบ</span>
        </div>
        <div class="h3 fw-700 mb-0"><%= fmtCompact(stats.totalAmount) %></div>
        <div class="text-muted mt-1 fs-85">ยอดสินเชื่อทั้งหมด</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="icon-box bg-info bg-opacity-10 text-info">
            <i class="bi bi-currency-exchange"></i>
          </div>
          <span class="badge bg-info bg-opacity-15 text-info">ยังผ่อนอยู่</span>
        </div>
        <div class="h3 fw-700 mb-0"><%= fmtCompact(stats.outstandingAmount) %></div>
        <div class="text-muted mt-1 fs-85">ยอดคงเหลือ</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="icon-box bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-hourglass-split"></i>
          </div>
          <span class="badge bg-warning bg-opacity-15 text-warning">รอดำเนินการ</span>
        </div>
        <div class="h3 fw-700 mb-0"><%= stats.pendingCount.toLocaleString('th-TH') %></div>
        <div class="text-muted mt-1 fs-85">รออนุมัติ</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card stat-card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="icon-box bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <span class="badge bg-danger bg-opacity-15 text-danger">ต้องติดตาม</span>
        </div>
        <div class="h3 fw-700 mb-0"><%= stats.overdueCount.toLocaleString('th-TH') %></div>
        <div class="text-muted mt-1 fs-85">ค้างชำระ</div>
      </div>
    </div>
  </div>
</div>

<!-- Filter & Search -->
<div class="card mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="search-input-group d-flex">
          <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control" placeholder="ค้นหาชื่อ, เลขที่สัญญา, เลขบัตร...">
        </div>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกประเภท</option>
          <option>สินเชื่อบุคคล</option>
          <option>สินเชื่อธุรกิจ</option>
          <option>สินเชื่อบ้าน</option>
          <option>สินเชื่อรถยนต์</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกสถานะ</option>
          <option>รออนุมัติ</option>
          <option>อนุมัติ</option>
          <option>ปฏิเสธ</option>
          <option>ปิดบัญชี</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>ค้นหา</button>
        <button class="btn btn-light border"><i class="bi bi-funnel"></i></button>
        <button class="btn btn-light border"><i class="bi bi-download"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Status Tabs -->
<%
  const tabs = [
    { key:'all',      label:'ทั้งหมด',    badgeClass:'bg-primary' },
    { key:'pending',  label:'รออนุมัติ',  badgeClass:'bg-warning text-dark' },
    { key:'approved', label:'อนุมัติแล้ว', badgeClass:'bg-success' },
    { key:'rejected', label:'ปฏิเสธ',     badgeClass:'bg-danger' },
    { key:'closed',   label:'ปิดบัญชี',    badgeClass:'bg-secondary' },
  ];
%>
<nav class="status-tabs mb-3" id="loanStatusTabs">
  <% tabs.forEach(t => {
       let isActive = activeStatus === t.key;
  %>
    <a class="status-tab <%= isActive ? 'active' : '' %>" data-status="<%= t.key %>" role="button">
      <span class="status-tab-label" data-label="<%= t.label %>"><%= t.label %></span>
      <span class="badge <%= t.badgeClass %>"><%= counts[t.key] %></span>
    </a>
  <% }) %>
</nav>

<script>
  document.getElementById("loanStatusTabs").addEventListener("click", function (e) {
    let tab = e.target.closest(".status-tab");
    if (!tab) return;
    this.querySelectorAll(".status-tab").forEach(el => el.classList.remove("active"));
    tab.classList.add("active");
  });
</script>

<!-- Table -->
<div class="card">
  <div class="table-responsive text-nowrap">
    <table id="table" class="table table-hover mb-0 align-middle">
      <thead class="table-custom-color">
        <tr>
          <th class="ps-4 col-checkbox">
            <input type="checkbox" class="form-check-input">
          </th>
          <th class="text-center fs-6">เลขที่สัญญา</th>
          <th class="text-center fs-6">ผู้กู้</th>
          <th class="text-center fs-6">ประเภทสินเชื่อ</th>
          <th class="text-center fs-6">วงเงิน</th>
          <th class="text-center fs-6">อัตราดอกเบี้ย</th>
          <th class="text-center fs-6">ระยะเวลา</th>
          <th class="text-center fs-6">งวดที่ผ่อน</th>
          <th class="text-center fs-6">สถานะ</th>
          <th class="text-center fs-6">วันที่ยื่น</th>
          <th class="text-center fs-6"></th>
        </tr>
      </thead>
    </table>
  </div>
</div>
<script src="/assets/scripts/loan/index.js?v<%= new Date().getTime() %>"></script>