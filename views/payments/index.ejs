<%- include('../partials/header', { title: 'การชำระเงิน', page: 'payments', breadcrumb: 'การชำระเงิน' }) %>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-0 fw-700">การชำระเงิน</h5>
    <p class="text-muted mb-0 fs-85">บันทึกและติดตามการชำระค่างวดสินเชื่อ</p>
  </div>
  <a href="/payments/new" class="btn btn-primary">
    <i class="bi bi-plus-circle me-2"></i>บันทึกการชำระเงิน
  </a>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-success bg-opacity-10 text-success">
            <i class="bi bi-cash-stack"></i>
          </div>
          <span class="badge bg-success bg-opacity-15 text-success fs-72">เดือนนี้</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2">฿1,284,500</div>
        <div class="text-muted fs-83">ยอดรับชำระรวม</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-receipt"></i>
          </div>
          <span class="badge bg-primary bg-opacity-15 text-primary fs-72">เดือนนี้</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2">248</div>
        <div class="text-muted fs-83">รายการชำระทั้งหมด</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
          <span class="badge bg-danger bg-opacity-15 text-danger fs-72">ต้องติดตาม</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2">32</div>
        <div class="text-muted fs-83">งวดค้างชำระ</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-calendar-event"></i>
          </div>
          <span class="badge bg-warning bg-opacity-15 text-warning fs-72">วันนี้</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2">18</div>
        <div class="text-muted fs-83">ครบกำหนดวันนี้</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Payment List -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body p-0">
        <div class="d-flex align-items-center justify-content-between p-4 pb-0 flex-wrap gap-2">
          <h6 class="mb-0 fw-600">รายการชำระล่าสุด</h6>
          <!-- Filter tabs -->
          <ul class="nav nav-pills nav-sm gap-1 fs-82">
            <li class="nav-item">
              <a class="nav-link active py-1 px-3" href="#">ทั้งหมด</a>
            </li>
            <li class="nav-item">
              <a class="nav-link py-1 px-3 text-muted" href="#">วันนี้</a>
            </li>
            <li class="nav-item">
              <a class="nav-link py-1 px-3 text-muted" href="#">ค้างชำระ</a>
            </li>
          </ul>
        </div>

        <!-- Search bar -->
        <div class="px-4 py-3">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" placeholder="ค้นหาเลขที่สัญญา, ชื่อผู้กู้...">
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th class="ps-4">เลขที่รับเงิน</th>
                <th>เลขสัญญา / ผู้กู้</th>
                <th>งวดที่</th>
                <th>ยอดชำระ</th>
                <th>ช่องทาง</th>
                <th>วันที่ชำระ</th>
                <th>สถานะ</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(p => { %>
              <tr>
                <td class="ps-4">
                  <span class="text-primary fw-500 fs-88"><%= p.receiptNo %></span>
                </td>
                <td>
                  <div class="fs-88 fw-500"><%= p.loanId %></div>
                  <div class="text-muted fs-78"><%= p.borrower %></div>
                </td>
                <td class="fs-88">งวดที่ <%= p.installment %></td>
                <td class="fw-600 fs-90">฿<%= p.amount %></td>
                <td>
                  <span class="badge bg-light text-secondary border fs-75">
                    <i class="bi bi-<%= p.channelIcon %> me-1"></i><%= p.channel %>
                  </span>
                </td>
                <td class="text-muted fs-83"><%= p.date %></td>
                <td>
                  <% if (p.status === 'สำเร็จ') { %>
                    <span class="badge-status bg-success bg-opacity-15 text-success"><i class="bi bi-check-circle-fill me-1"></i>สำเร็จ</span>
                  <% } else if (p.status === 'ค้างชำระ') { %>
                    <span class="badge-status bg-danger bg-opacity-15 text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i>ค้างชำระ</span>
                  <% } else { %>
                    <span class="badge-status bg-warning bg-opacity-20 text-warning"><i class="bi bi-clock-fill me-1"></i><%= p.status %></span>
                  <% } %>
                </td>
                <td>
                  <a href="/payments/<%= p.receiptNo %>" class="btn btn-sm btn-light border-0">
                    <i class="bi bi-eye"></i>
                  </a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="d-flex align-items-center justify-content-between p-3 border-top flex-wrap gap-2">
          <div class="text-muted fs-85">แสดง 1-10 จาก 248 รายการ</div>
          <nav>
            <ul class="pagination pagination-sm mb-0 gap-1">
              <li class="page-item disabled"><a class="page-link border-0" href="#">&laquo;</a></li>
              <li class="page-item active"><a class="page-link rounded" href="#">1</a></li>
              <li class="page-item"><a class="page-link border-0" href="#">2</a></li>
              <li class="page-item"><a class="page-link border-0" href="#">3</a></li>
              <li class="page-item"><a class="page-link border-0" href="#">&raquo;</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: Due Today + Overdue -->
  <div class="col-lg-4 d-flex flex-column gap-3">
    <!-- Due Today -->
    <div class="card">
      <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h6 class="mb-0 fw-600">ครบกำหนดวันนี้</h6>
          <span class="badge bg-warning text-dark">18 รายการ</span>
        </div>
        <div class="d-flex flex-column gap-2">
          <% dueTodayList.forEach(d => { %>
          <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-surface">
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-circle d-flex align-items-center justify-content-center text-white avatar-sm fw-700 flex-shrink-0"
                   style="background:<%= d.color %>;">
                <%= d.name.charAt(0) %>
              </div>
              <div>
                <div class="fs-82 fw-500"><%= d.name %></div>
                <div class="text-muted fs-74"><%= d.loanId %> · งวดที่ <%= d.installment %></div>
              </div>
            </div>
            <div class="text-end">
              <div class="fw-600 text-primary fs-85">฿<%= d.amount %></div>
              <a href="/payments/new?loan=<%= d.loanId %>" class="btn btn-xs btn-outline-primary py-0 px-2 fs-72">ชำระ</a>
            </div>
          </div>
          <% }) %>
        </div>
        <a href="#" class="btn btn-outline-secondary btn-sm w-100 mt-2">ดูทั้งหมด</a>
      </div>
    </div>

    <!-- Overdue -->
    <div class="card border-danger border-opacity-25">
      <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h6 class="mb-0 fw-600 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>ค้างชำระ</h6>
          <span class="badge bg-danger">32 รายการ</span>
        </div>
        <div class="d-flex flex-column gap-2">
          <% overdueList.forEach(o => { %>
          <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-danger-tint">
            <div>
              <div class="fs-82 fw-500"><%= o.name %></div>
              <div class="text-muted fs-74"><%= o.loanId %></div>
            </div>
            <div class="text-end">
              <div class="fw-600 text-danger fs-85">฿<%= o.amount %></div>
              <div class="text-danger fs-74"><%= o.overdueDays %> วันที่ค้าง</div>
            </div>
          </div>
          <% }) %>
        </div>
        <a href="/payments?status=overdue" class="btn btn-outline-danger btn-sm w-100 mt-2">จัดการค้างชำระ</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
