<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-0 fw-700">รายการสินเชื่อ</h5>
    <p class="text-muted mb-0 fs-85">จัดการและติดตามสินเชื่อทั้งหมด</p>
  </div>
  <a href="/loan/apply" class="btn btn-primary">
    <i class="bi bi-plus-circle me-2"></i>ยื่นขอสินเชื่อใหม่
  </a>
</div>

<!-- Filter & Search -->
<div class="card mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control border-start-0 ps-0" placeholder="ค้นหาชื่อ, เลขที่สัญญา, เลขบัตร...">
        </div>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกประเภท</option>
          <option>สินเชื่อบุคคล</option>
          <option>สินเชื่อธุรกิจ</option>
          <option>สินเชื่อบ้าน</option>
          <option>สินเชื่อรถยนต์</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกสถานะ</option>
          <option>รออนุมัติ</option>
          <option>อนุมัติ</option>
          <option>ปฏิเสธ</option>
          <option>ปิดบัญชี</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>ค้นหา</button>
        <button class="btn btn-light border"><i class="bi bi-funnel"></i></button>
        <button class="btn btn-light border"><i class="bi bi-download"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Status Tabs -->
<%
  const tabs = [
    { key:'all',      label:'ทั้งหมด',    badgeClass:'bg-primary' },
    { key:'pending',  label:'รออนุมัติ',  badgeClass:'bg-warning text-dark' },
    { key:'approved', label:'อนุมัติแล้ว', badgeClass:'bg-success' },
    { key:'rejected', label:'ปฏิเสธ',     badgeClass:'bg-danger' },
    { key:'closed',   label:'ปิดบัญชี',    badgeClass:'bg-secondary' },
  ];
%>
<nav class="status-tabs mb-3">
  <% tabs.forEach(t => {
       const isActive = activeStatus === t.key;
       const href = t.key === 'all' ? '/loan' : '/loan?status=' + t.key;
  %>
    <a class="status-tab <%= isActive ? 'active' : '' %>" href="<%= href %>">
      <%= t.label %> <span class="badge <%= t.badgeClass %>"><%= counts[t.key] %></span>
    </a>
  <% }) %>
</nav>

<!-- Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width:40px;">
              <input type="checkbox" class="form-check-input">
            </th>
            <th>เลขที่สัญญา</th>
            <th>ผู้กู้</th>
            <th>ประเภทสินเชื่อ</th>
            <th>วงเงิน</th>
            <th>อัตราดอกเบี้ย</th>
            <th>ระยะเวลา</th>
            <th>งวดที่ผ่อน</th>
            <th>สถานะ</th>
            <th>วันที่ยื่น</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% allLoans.forEach(loan => { %>
          <tr>
            <td class="ps-4"><input type="checkbox" class="form-check-input"></td>
            <td>
              <a href="/loan/<%= loan.id %>" class="text-primary fw-500 text-decoration-none">
                <%= loan.id %>
              </a>
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white avatar-md flex-shrink-0"
                     style="background:<%= loan.color %>;">
                  <%= loan.name.charAt(0) %>
                </div>
                <div>
                  <div class="fs-88 fw-500"><%= loan.name %></div>
                  <div class="text-muted fs-78"><%= loan.phone %></div>
                </div>
              </div>
            </td>
            <td><span class="text-muted fs-88"><%= loan.type %></span></td>
            <td class="fw-500">฿<%= loan.amount %></td>
            <td><%= loan.rate %>%</td>
            <td><%= loan.term %> เดือน</td>
            <td>
              <div class="fs-80">
                <span class="fw-500"><%= loan.paidInstallments %></span>
                <span class="text-muted">/ <%= loan.term %></span>
              </div>
              <div class="progress mt-1" style="width:80px;">
                <div class="progress-bar bg-primary" style="width:<%= Math.round(loan.paidInstallments/loan.term*100) %>%"></div>
              </div>
            </td>
            <td>
              <% if (loan.status === 'อนุมัติ') { %>
                <span class="badge-status bg-success bg-opacity-15 text-success"><i class="bi bi-check-circle-fill me-1"></i><%= loan.status %></span>
              <% } else if (loan.status === 'รออนุมัติ') { %>
                <span class="badge-status bg-warning bg-opacity-20 text-warning"><i class="bi bi-clock-fill me-1"></i><%= loan.status %></span>
              <% } else if (loan.status === 'ปฏิเสธ') { %>
                <span class="badge-status bg-danger bg-opacity-15 text-danger"><i class="bi bi-x-circle-fill me-1"></i><%= loan.status %></span>
              <% } else { %>
                <span class="badge-status bg-secondary bg-opacity-15 text-secondary"><%= loan.status %></span>
              <% } %>
            </td>
            <td class="text-muted fs-85"><%= loan.date %></td>
            <td>
              <div class="dropdown">
                <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown">
                  <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 dropdown-menu-text">
                  <li><a class="dropdown-item" href="/loan/<%= loan.id %>"><i class="bi bi-eye me-2"></i>ดูรายละเอียด</a></li>
                  <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>แก้ไข</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>ลบ</a></li>
                </ul>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <!-- Pagination -->
    <div class="d-flex align-items-center justify-content-between p-3 border-top flex-wrap gap-2">
      <div class="text-muted fs-85">แสดง <%= allLoans.length %> จาก <%= counts.all %> รายการ</div>
      <nav>
        <ul class="pagination pagination-sm mb-0 gap-1">
          <li class="page-item disabled"><a class="page-link border-0" href="#">&laquo;</a></li>
          <li class="page-item active"><a class="page-link rounded" href="#">1</a></li>
          <li class="page-item"><a class="page-link border-0" href="#">2</a></li>
          <li class="page-item"><a class="page-link border-0" href="#">3</a></li>
          <li class="page-item"><span class="page-link border-0">...</span></li>
          <li class="page-item"><a class="page-link border-0" href="#">125</a></li>
          <li class="page-item"><a class="page-link border-0" href="#">&raquo;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</div>
