<div class="auth-page">

  <!-- Brand Panel (left) -->
  <div class="auth-brand">
    <div class="auth-brand-logo">
      <div class="logo-icon"><i class="bi bi-bank2"></i></div>
      <div>
        <div class="fw-700 fs-5">LoanPro</div>
        <div class="text-white-50 fs-80">ระบบบริหารสินเชื่อ</div>
      </div>
    </div>

    <div class="auth-brand-hero">
      <h1>ยินดีต้อนรับสู่<br>ระบบบริหารสินเชื่อ</h1>
      <p>
        จัดการคำขอสินเชื่อ ติดตามการชำระ และดูภาพรวมพอร์ตของคุณได้ในที่เดียว
        ทำงานเร็วขึ้น ตัดสินใจแม่นยำขึ้น
      </p>
    </div>

    <div class="auth-brand-features">
      <div class="auth-brand-feature">
        <i class="bi bi-shield-check"></i>
        <span>เข้ารหัสและจัดเก็บข้อมูลตามมาตรฐาน ปปง. / ธปท.</span>
      </div>
      <div class="auth-brand-feature">
        <i class="bi bi-graph-up-arrow"></i>
        <span>รายงานและแดชบอร์ดสำหรับผู้บริหาร เรียลไทม์</span>
      </div>
      <div class="auth-brand-feature">
        <i class="bi bi-people"></i>
        <span>รองรับการทำงานหลายผู้ใช้พร้อมกัน</span>
      </div>
    </div>

    <div class="auth-brand-foot">
      &copy; <%= new Date().getFullYear() + 543 %> LoanPro · เวอร์ชัน 1.0
    </div>
  </div>

  <!-- Form Panel (right) -->
  <div class="auth-panel">
    <div class="auth-panel-inner">

      <div class="auth-panel-title">เข้าสู่ระบบ</div>
      <div class="auth-panel-subtitle">กรอกข้อมูลเพื่อเข้าใช้งานระบบบริหารสินเชื่อ</div>

      <% if (error) { %>
        <div class="alert alert-danger border-0 rounded-3 fs-85">
          <i class="bi bi-exclamation-triangle-fill me-1"></i><%= error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" autocomplete="off">

        <div class="mb-3">
          <label class="form-label">ชื่อผู้ใช้ หรือ อีเมล</label>
          <div class="auth-input-icon">
            <i class="bi bi-person"></i>
            <input type="text" class="form-control" name="username"
                   placeholder="username หรือ email"
                   value="<%= username %>" required autofocus>
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label">รหัสผ่าน</label>
          <div class="auth-input-icon">
            <i class="bi bi-lock"></i>
            <input type="password" class="form-control" id="password"
                   name="password" placeholder="รหัสผ่าน" required>
            <button type="button" class="auth-toggle-pass" id="togglePass" aria-label="แสดง/ซ่อนรหัสผ่าน">
              <i class="bi bi-eye" id="togglePassIcon"></i>
            </button>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="remember" name="remember">
            <label class="form-check-label fs-85" for="remember">จดจำการเข้าสู่ระบบ</label>
          </div>
          <a href="#" class="text-primary text-decoration-none fs-85">ลืมรหัสผ่าน?</a>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-box-arrow-in-right me-1"></i>เข้าสู่ระบบ
        </button>

        <div class="auth-divider">หรือ</div>

        <button type="button" class="auth-social-btn">
          <i class="bi bi-google"></i>เข้าสู่ระบบด้วย Google
        </button>

        <div class="text-center mt-4 fs-85 text-muted">
          ยังไม่มีบัญชี?
          <a href="#" class="text-primary text-decoration-none fw-500">ติดต่อผู้ดูแลระบบ</a>
        </div>
      </form>

    </div>
  </div>

</div>

<script>
  (function () {
    const togglePass = document.getElementById('togglePass');
    const password = document.getElementById('password');
    const icon = document.getElementById('togglePassIcon');
    if (!togglePass || !password || !icon) return;
    togglePass.addEventListener('click', () => {
      const show = password.type === 'password';
      password.type = show ? 'text' : 'password';
      icon.classList.toggle('bi-eye', !show);
      icon.classList.toggle('bi-eye-slash', show);
    });
  })();
</script>
