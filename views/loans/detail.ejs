<%- include('../partials/header', { title: 'รายละเอียดสินเชื่อ', page: 'loans', breadcrumb: 'รายละเอียดสินเชื่อ' }) %>

<!-- Header row -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div class="d-flex align-items-center gap-3">
    <a href="/loans" class="btn btn-sm btn-light border"><i class="bi bi-arrow-left"></i></a>
    <div>
      <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0 fw-700"><%= loan.id %></h5>
        <% if (loan.status === 'อนุมัติ') { %>
          <span class="badge-status bg-success bg-opacity-15 text-success"><i class="bi bi-check-circle-fill me-1"></i><%= loan.status %></span>
        <% } else if (loan.status === 'รออนุมัติ') { %>
          <span class="badge-status bg-warning bg-opacity-20 text-warning"><i class="bi bi-clock-fill me-1"></i><%= loan.status %></span>
        <% } else if (loan.status === 'ปฏิเสธ') { %>
          <span class="badge-status bg-danger bg-opacity-15 text-danger"><i class="bi bi-x-circle-fill me-1"></i><%= loan.status %></span>
        <% } %>
      </div>
      <div class="text-muted fs-83">วันที่ยื่น <%= loan.date %></div>
    </div>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-sm btn-light border"><i class="bi bi-printer me-1"></i>พิมพ์</button>
    <button class="btn btn-sm btn-primary"><i class="bi bi-check-circle me-1"></i>อนุมัติ</button>
    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle me-1"></i>ปฏิเสธ</button>
  </div>
</div>

<div class="row g-4">
  <!-- Left col -->
  <div class="col-lg-8 d-flex flex-column gap-4">

    <!-- ข้อมูลผู้กู้ -->
    <div class="card">
      <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <h6 class="fw-700 mb-0"><i class="bi bi-person-circle text-primary me-2"></i>ข้อมูลผู้กู้</h6>
          <a href="#" class="btn btn-sm btn-light border-0"><i class="bi bi-pencil"></i></a>
        </div>
        <div class="row g-3">
          <div class="col-auto">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fs-4 fw-700 avatar-xl"
                 style="background:<%= loan.color %>;">
              <%= loan.name.charAt(0) %>
            </div>
          </div>
          <div class="col">
            <div class="fs-6 fw-600"><%= loan.name %></div>
            <div class="text-muted fs-85">
              <i class="bi bi-phone me-1"></i><%= loan.phone %> &nbsp;
              <i class="bi bi-envelope me-1"></i><%= loan.email %>
            </div>
            <div class="text-muted fs-85">
              <i class="bi bi-geo-alt me-1"></i><%= loan.address %>
            </div>
          </div>
        </div>
        <hr>
        <div class="row g-2">
          <div class="col-md-4">
            <div class="text-muted fs-78">เลขบัตรประชาชน</div>
            <div class="fs-88 fw-500"><%= loan.idCard %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">อาชีพ</div>
            <div class="fs-88 fw-500"><%= loan.occupation %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">รายได้ต่อเดือน</div>
            <div class="fs-88 fw-500">฿<%= loan.income %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- รายละเอียดสินเชื่อ -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-4"><i class="bi bi-currency-dollar text-primary me-2"></i>รายละเอียดสินเชื่อ</h6>
        <div class="row g-3">
          <div class="col-md-4">
            <div class="p-3 rounded-3 text-center bg-primary-tint">
              <div class="text-primary fw-700 fs-4">฿<%= loan.amount %></div>
              <div class="text-muted fs-78">วงเงินสินเชื่อ</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 rounded-3 text-center bg-success-tint">
              <div class="text-success fw-700 fs-4"><%= loan.rate %>%</div>
              <div class="text-muted fs-78">อัตราดอกเบี้ย/ปี</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 rounded-3 text-center bg-warning-tint">
              <div class="text-warning fw-700 fs-4"><%= loan.term %> เดือน</div>
              <div class="text-muted fs-78">ระยะเวลาผ่อน</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">ค่างวดต่อเดือน</div>
            <div class="fs-95 fw-600">฿<%= loan.monthly %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">ดอกเบี้ยรวม</div>
            <div class="fs-95 fw-600">฿<%= loan.totalInterest %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">ยอดชำระรวม</div>
            <div class="fs-95 fw-600">฿<%= loan.totalPayment %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">วันที่เริ่มสัญญา</div>
            <div class="fs-88 fw-500"><%= loan.startDate %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">วันที่สิ้นสุดสัญญา</div>
            <div class="fs-88 fw-500"><%= loan.endDate %></div>
          </div>
          <div class="col-md-4">
            <div class="text-muted fs-78">ประเภทสินเชื่อ</div>
            <div class="fs-88 fw-500"><%= loan.type %></div>
          </div>
        </div>

        <!-- Progress -->
        <div class="mt-4">
          <div class="d-flex justify-content-between mb-1">
            <span class="fs-85">ความคืบหน้าการผ่อน</span>
            <span class="text-primary fw-600 fs-85"><%= loan.paidInstallments %>/<%= loan.term %> งวด (<%= Math.round(loan.paidInstallments/loan.term*100) %>%)</span>
          </div>
          <div class="progress progress-8">
            <div class="progress-bar bg-primary" style="width:<%= Math.round(loan.paidInstallments/loan.term*100) %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ตารางผ่อนชำระ -->
    <div class="card">
      <div class="card-body p-0">
        <div class="d-flex align-items-center justify-content-between p-4 pb-3">
          <h6 class="fw-700 mb-0"><i class="bi bi-table text-primary me-2"></i>ตารางการผ่อนชำระ</h6>
          <button class="btn btn-sm btn-light border"><i class="bi bi-download me-1"></i>ส่งออก</button>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0 table-compact">
            <thead class="table-light">
              <tr>
                <th class="ps-4">งวดที่</th>
                <th>วันครบกำหนด</th>
                <th>เงินต้น</th>
                <th>ดอกเบี้ย</th>
                <th>ค่างวด</th>
                <th>เงินต้นคงเหลือ</th>
                <th>สถานะ</th>
              </tr>
            </thead>
            <tbody>
              <% schedule.forEach(row => { %>
              <tr class="<%= row.status === 'ชำระแล้ว' ? 'text-muted' : '' %>">
                <td class="ps-4 fw-500"><%= row.no %></td>
                <td><%= row.dueDate %></td>
                <td>฿<%= row.principal %></td>
                <td>฿<%= row.interest %></td>
                <td class="fw-500">฿<%= row.payment %></td>
                <td>฿<%= row.balance %></td>
                <td>
                  <% if (row.status === 'ชำระแล้ว') { %>
                    <span class="text-success fs-78"><i class="bi bi-check-circle-fill me-1"></i>ชำระแล้ว</span>
                  <% } else if (row.status === 'ค้างชำระ') { %>
                    <span class="text-danger fs-78"><i class="bi bi-exclamation-circle-fill me-1"></i>ค้างชำระ</span>
                  <% } else { %>
                    <span class="text-muted fs-78"><i class="bi bi-clock me-1"></i>รอชำระ</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Right col -->
  <div class="col-lg-4 d-flex flex-column gap-4">

    <!-- Timeline -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-4"><i class="bi bi-activity text-primary me-2"></i>ประวัติการดำเนินการ</h6>
        <div class="timeline">
          <% timeline.forEach(item => { %>
          <div class="timeline-item">
            <div class="timeline-dot" style="color:<%= item.color %>;background:<%= item.color %>;"></div>
            <div class="fs-85 fw-500"><%= item.title %></div>
            <div class="text-muted fs-78"><%= item.desc %></div>
            <div class="text-muted fs-75"><%= item.date %></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- เอกสาร -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-3"><i class="bi bi-paperclip text-primary me-2"></i>เอกสารแนบ</h6>
        <div class="d-flex flex-column gap-2">
          <% documents.forEach(doc => { %>
          <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-surface">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
              <div>
                <div class="fs-83 fw-500"><%= doc.name %></div>
                <div class="text-muted fs-75"><%= doc.size %></div>
              </div>
            </div>
            <a href="#" class="btn btn-sm btn-light border-0"><i class="bi bi-download"></i></a>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
