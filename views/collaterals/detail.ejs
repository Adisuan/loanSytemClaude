<%- include('../partials/header', { title: item.title, page: 'collaterals', breadcrumb: 'หลักประกัน' }) %>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div class="d-flex align-items-center gap-3">
    <a href="/collaterals" class="btn btn-sm btn-light border"><i class="bi bi-arrow-left"></i></a>
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <h5 class="mb-0 fw-700"><%= item.title %></h5>
        <% if (item.status === 'ว่าง') { %>
          <span class="badge-status bg-success bg-opacity-15 text-success"><i class="bi bi-check-circle-fill me-1"></i>ว่าง</span>
        <% } else if (item.status === 'ใช้ค้ำอยู่') { %>
          <span class="badge-status bg-warning bg-opacity-20 text-warning"><i class="bi bi-link-45deg me-1"></i>ใช้ค้ำอยู่</span>
        <% } else { %>
          <span class="badge-status bg-secondary bg-opacity-15 text-secondary"><i class="bi bi-archive-fill me-1"></i>ปลดแล้ว</span>
        <% } %>
      </div>
      <div class="text-muted fs-83">รหัส <%= item.id %> · เพิ่มเมื่อ <%= item.addedDate %></div>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/collaterals/<%= item.id %>/edit" class="btn btn-sm btn-light border">
      <i class="bi bi-pencil me-1"></i>แก้ไข
    </a>
    <% if (item.status !== 'ใช้ค้ำอยู่') { %>
      <form action="/collaterals/<%= item.id %>/delete" method="POST" class="m-0">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-trash me-1"></i>ลบ
        </button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-4">
  <!-- Left -->
  <div class="col-lg-8 d-flex flex-column gap-4">

    <!-- ข้อมูลหลักประกัน -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-4"><i class="bi bi-shield-fill text-primary me-2"></i>ข้อมูลหลักประกัน</h6>

        <div class="row g-3 align-items-center mb-4">
          <div class="col-auto">
            <div class="rounded d-flex align-items-center justify-content-center text-white"
                 style="background:<%= item.color %>; width:64px; height:64px; font-size:1.6rem;">
              <i class="bi <%= item.icon %>"></i>
            </div>
          </div>
          <div class="col">
            <div class="fs-6 fw-600"><%= item.title %></div>
            <div class="text-muted fs-85"><%= item.type %></div>
          </div>
          <div class="col-auto text-end">
            <div class="text-muted fs-78">มูลค่าประเมิน</div>
            <div class="fw-700 fs-5 text-primary">฿<%= item.estimatedValue %></div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-md-12">
            <div class="text-muted fs-78">รายละเอียด</div>
            <div class="fs-88"><%= item.description %></div>
          </div>
          <% if (item.note) { %>
          <div class="col-md-12">
            <div class="text-muted fs-78">หมายเหตุ</div>
            <div class="fs-88"><%= item.note %></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- สัญญาที่ผูก -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-4"><i class="bi bi-link-45deg text-primary me-2"></i>สัญญาที่ผูก</h6>

        <% if (item.loanId) { %>
          <div class="p-3 rounded-3 bg-surface d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <div class="fs-88 fw-600">
                <a href="/loans/<%= item.loanId %>" class="text-primary text-decoration-none">
                  <%= item.loanId %>
                </a>
              </div>
              <div class="text-muted fs-78">ผูกเมื่อ <%= item.attachedDate %></div>
            </div>
            <div>
              <% if (item.status === 'ใช้ค้ำอยู่') { %>
                <span class="badge-status bg-warning bg-opacity-20 text-warning">
                  <i class="bi bi-link-45deg me-1"></i>ติดสัญญาอยู่
                </span>
              <% } else { %>
                <span class="badge-status bg-secondary bg-opacity-15 text-secondary">
                  <i class="bi bi-archive-fill me-1"></i>ปลดแล้ว
                </span>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
            หลักประกันชิ้นนี้ยังไม่ได้ผูกกับสัญญาใด
            <div class="mt-3">
              <a href="/loans/apply" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-circle me-1"></i>ทำสัญญาใหม่
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Right -->
  <div class="col-lg-4 d-flex flex-column gap-4">

    <!-- สถานะ -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-4"><i class="bi bi-info-circle-fill text-primary me-2"></i>สถานะ</h6>
        <div class="d-flex flex-column gap-3">
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted fs-85">รหัส</span>
            <span class="fw-600"><%= item.id %></span>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted fs-85">ประเภท</span>
            <span class="fw-600"><%= item.type %></span>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted fs-85">มูลค่าประเมิน</span>
            <span class="fw-600">฿<%= item.estimatedValue %></span>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted fs-85">สถานะ</span>
            <% if (item.status === 'ว่าง') { %>
              <span class="text-success fw-600"><%= item.status %></span>
            <% } else if (item.status === 'ใช้ค้ำอยู่') { %>
              <span class="text-warning fw-600"><%= item.status %></span>
            <% } else { %>
              <span class="text-secondary fw-600"><%= item.status %></span>
            <% } %>
          </div>
          <div class="d-flex justify-content-between py-2">
            <span class="text-muted fs-85">วันที่เพิ่ม</span>
            <span class="fw-600"><%= item.addedDate %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- การกระทำ -->
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-700 mb-3"><i class="bi bi-lightning-fill text-warning me-2"></i>การกระทำ</h6>
        <div class="d-grid gap-2">
          <a href="/collaterals/<%= item.id %>/edit" class="btn btn-light border text-start">
            <i class="bi bi-pencil me-2"></i>แก้ไขข้อมูล
          </a>
          <% if (item.status === 'ว่าง') { %>
            <a href="/loans/apply" class="btn btn-light border text-start">
              <i class="bi bi-link-45deg me-2"></i>นำไปค้ำสัญญา
            </a>
          <% } %>
          <button class="btn btn-light border text-start" disabled>
            <i class="bi bi-printer me-2"></i>พิมพ์ใบประเมิน
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
