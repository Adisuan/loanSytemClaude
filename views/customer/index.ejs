<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-0 fw-700">ข้อมูลลูกค้า</h5>
    <p class="text-muted mb-0 fs-85">จัดการและค้นหาข้อมูลลูกค้าทั้งหมด</p>
  </div>
  <a href="/loan/apply" class="btn btn-primary">
    <i class="bi bi-plus-circle me-2"></i>เพิ่มลูกค้าใหม่
  </a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-people-fill"></i>
          </div>
          <span class="badge bg-primary bg-opacity-15 text-primary fs-72">ทั้งหมด</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.total %></div>
        <div class="text-muted fs-83">ลูกค้าทั้งหมด</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-success bg-opacity-10 text-success">
            <i class="bi bi-person-plus-fill"></i>
          </div>
          <span class="badge bg-success bg-opacity-15 text-success fs-72">เดือนนี้</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.newThisMonth %></div>
        <div class="text-muted fs-83">ลูกค้าใหม่</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-info bg-opacity-10 text-info">
            <i class="bi bi-file-earmark-text-fill"></i>
          </div>
          <span class="badge bg-info bg-opacity-15 text-info fs-72">มีสินเชื่อ</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.hasLoan %></div>
        <div class="text-muted fs-83">ลูกค้ามีสินเชื่อ</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card h-100">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div class="icon-box bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <span class="badge bg-danger bg-opacity-15 text-danger fs-72">ต้องติดตาม</span>
        </div>
        <div class="h4 fw-700 mb-0 mt-2"><%= stats.overdue %></div>
        <div class="text-muted fs-83">ค้างชำระ</div>
      </div>
    </div>
  </div>
</div>

<!-- Search & Filter -->
<div class="card mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control border-start-0 ps-0" placeholder="ค้นหาชื่อ, เลขบัตร, เบอร์โทร...">
        </div>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกอาชีพ</option>
          <option>พนักงานเอกชน</option>
          <option>ข้าราชการ/รัฐวิสาหกิจ</option>
          <option>ธุรกิจส่วนตัว</option>
          <option>เกษตรกร</option>
          <option>ฟรีแลนซ์</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select">
          <option>ทุกสถานะ</option>
          <option>ปกติ</option>
          <option>ติดตาม</option>
          <option>ค้างชำระ</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>ค้นหา</button>
        <button class="btn btn-light border"><i class="bi bi-download"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Customer Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width:40px;">
              <input type="checkbox" class="form-check-input">
            </th>
            <th>ลูกค้า</th>
            <th>เลขบัตรประชาชน</th>
            <th>เบอร์โทร</th>
            <th>อาชีพ</th>
            <th>รายได้/เดือน</th>
            <th>สินเชื่อ</th>
            <th>สถานะ</th>
            <th>วันที่ลงทะเบียน</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% customers.forEach(c => { %>
          <tr>
            <td class="ps-4"><input type="checkbox" class="form-check-input"></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white avatar-md flex-shrink-0"
                     style="background:<%= c.color %>;">
                  <%= c.name.charAt(0) %>
                </div>
                <div>
                  <div class="fs-88 fw-500"><%= c.prefix %><%= c.name %></div>
                  <div class="text-muted fs-78"><%= c.email %></div>
                </div>
              </div>
            </td>
            <td class="text-muted fs-85"><%= c.idCard %></td>
            <td class="fs-85"><%= c.phone %></td>
            <td class="text-muted fs-85"><%= c.occupation %></td>
            <td class="fw-500 fs-85">฿<%= c.income %></td>
            <td>
              <div class="fs-80">
                <span class="fw-500 text-primary"><%= c.activeLoans %></span>
                <span class="text-muted"> สัญญา</span>
              </div>
              <div class="text-muted fs-75">รวม <%= c.loanCount %> สัญญา</div>
            </td>
            <td>
              <% if (c.status === 'ปกติ') { %>
                <span class="badge-status bg-success bg-opacity-15 text-success">
                  <i class="bi bi-check-circle-fill me-1"></i>ปกติ
                </span>
              <% } else if (c.status === 'ติดตาม') { %>
                <span class="badge-status bg-warning bg-opacity-20 text-warning">
                  <i class="bi bi-exclamation-circle-fill me-1"></i>ติดตาม
                </span>
              <% } else { %>
                <span class="badge-status bg-danger bg-opacity-15 text-danger">
                  <i class="bi bi-x-circle-fill me-1"></i>ค้างชำระ
                </span>
              <% } %>
            </td>
            <td class="text-muted fs-85"><%= c.joinDate %></td>
            <td>
              <a href="/customer/<%= c.id %>" class="btn btn-sm btn-light border-0">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="d-flex align-items-center justify-content-between p-3 border-top flex-wrap gap-2">
      <div class="text-muted fs-85">แสดง 1-<%= customers.length %> จาก <%= customers.length %> รายการ</div>
      <nav>
        <ul class="pagination pagination-sm mb-0 gap-1">
          <li class="page-item disabled"><a class="page-link border-0" href="#">&laquo;</a></li>
          <li class="page-item active"><a class="page-link rounded" href="#">1</a></li>
          <li class="page-item"><a class="page-link border-0" href="#">&raquo;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</div>
